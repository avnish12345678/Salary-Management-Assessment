generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  HR_MANAGER
  HR_EXECUTIVE
  VIEWER
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

model Country {
  id           String     @id @default(uuid()) @db.Uuid
  code         String     @unique @db.VarChar(3)
  name         String     @db.VarChar(100)
  currencyCode String     @map("currency_code") @db.Char(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees    Employee[]

  @@map("countries")
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(32)
  name      String     @db.VarChar(100)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees Employee[]

  @@map("departments")
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  employeeCode     String           @unique @map("employee_code") @db.VarChar(32)
  firstName        String           @map("first_name") @db.VarChar(100)
  lastName         String           @map("last_name") @db.VarChar(100)
  email            String           @unique @db.VarChar(255)
  phone            String?          @db.VarChar(32)
  departmentId     String           @map("department_id") @db.Uuid
  designation      String           @db.VarChar(100)
  countryId        String           @map("country_id") @db.Uuid
  city             String           @db.VarChar(100)
  joiningDate      DateTime         @map("joining_date") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  managerId        String?          @map("manager_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  department      Department       @relation(fields: [departmentId], references: [id])
  country         Country          @relation(fields: [countryId], references: [id])
  manager         Employee?        @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports   Employee[]       @relation("EmployeeManager")
  user            User?
  salaryRecords   SalaryRecord[]
  salaryRevisions SalaryRevision[]

  @@index([lastName, firstName])
  @@index([departmentId])
  @@index([countryId])
  @@index([employmentStatus])
  @@index([designation])
  @@index([joiningDate])
  @@map("employees")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  role         Role
  employeeId   String?  @unique @map("employee_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee         Employee?        @relation(fields: [employeeId], references: [id])
  salaryRevisions  SalaryRevision[]
  auditLogs        AuditLog[]

  @@map("users")
}

model SalaryRecord {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  baseSalary   Decimal   @map("base_salary") @db.Decimal(14, 2)
  bonus        Decimal   @default(0) @db.Decimal(14, 2)
  allowances   Decimal   @default(0) @db.Decimal(14, 2)
  deductions   Decimal   @default(0) @db.Decimal(14, 2)
  currency     String    @db.Char(3)
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee            Employee         @relation(fields: [employeeId], references: [id])
  revisionsAsPrevious SalaryRevision[] @relation("PreviousSalaryRecord")
  revisionsAsNew      SalaryRevision[] @relation("NewSalaryRecord")

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([currency])
  @@index([effectiveFrom])
  @@map("salary_records")
}

model SalaryRevision {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  previousRecordId String?  @map("previous_record_id") @db.Uuid
  newRecordId      String   @map("new_record_id") @db.Uuid
  changedBy        String   @map("changed_by") @db.Uuid
  changeReason     String?  @map("change_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  employee       Employee     @relation(fields: [employeeId], references: [id])
  previousRecord SalaryRecord? @relation("PreviousSalaryRecord", fields: [previousRecordId], references: [id])
  newRecord      SalaryRecord @relation("NewSalaryRecord", fields: [newRecordId], references: [id])
  changedByUser  User         @relation(fields: [changedBy], references: [id])

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("salary_revisions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String   @map("entity_id") @db.Uuid
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_logs")
}
