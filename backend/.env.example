NODE_ENV=development
PORT=4000
# Prefer connection_limit on managed Postgres / poolers in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acme_salary?schema=public&connection_limit=10
# Production requires >= 32 chars and must not look like a placeholder.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
LOG_LEVEL=info
