# Copy values into backend/.env and frontend/.env (never commit real secrets).

# Backend
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acme_salary?schema=public&connection_limit=10
# Production: >= 32 characters, not a placeholder like change-me / dev-only
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
BCRYPT_SALT_ROUNDS=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
LOG_LEVEL=info

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api

# --- Production examples (set in Vercel / Render dashboards) ---
# NODE_ENV=production
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/acme_salary?schema=public&connection_limit=5&sslmode=require
# JWT_SECRET=<generate-a-long-random-string>
# CORS_ORIGIN=https://your-app.vercel.app
# VITE_API_BASE_URL=https://your-api.onrender.com/api
